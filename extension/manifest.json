{
  "manifest_version": 3,
  "name": "CodeRevise Capture",
  "version": "1.0.0",
  "description": "Capture coding problem pages into CodeRevise in one click.",
  "permissions": ["tabs", "windows"],
  "action": {
    "default_title": "Capture to CodeRevise",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
